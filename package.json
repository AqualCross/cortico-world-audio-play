{
  "name": "cortico-world-audio-play",
  "version": "0.3.0",
  "type": "module",
  "description": "音频播放（Audio Play）—— 给 Coopanion 桌宠的 cortico World 扩展：把 log:/mem: 音频句柄或本地音频文件交给本机播放器播放（后端可配置，支持 ffplay / mpv / VLC 与自定义命令），开始播放后立刻返回，失败才发事件；也可以监听其他扩展的声音事件自动播放。 / A cortico World extension that plays a log:/mem: audio handle or a local audio file through a configurable local player (ffplay / mpv / VLC or a custom command): the tool returns as soon as playback starts and only failures arrive as events. It can also watch voice events from other extensions and play their audio automatically.",
  "license": "MIT",
  "author": {
    "name": "AqualCross"
  },
  "homepage": "https://github.com/AqualCross/cortico-world-audio-play#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AqualCross/cortico-world-audio-play.git"
  },
  "bugs": {
    "url": "https://github.com/AqualCross/cortico-world-audio-play/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "audio",
    "audio-playback",
    "play",
    "speaker",
    "playback",
    "tts",
    "voice",
    "wav",
    "mp3"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "describe.json",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "selfcheck": "node tools/check.mjs",
    "describe:extension": "node tools/describe.mjs",
    "drymount": "node --experimental-transform-types tools/drymount.mts",
    "smoke": "node tools/smoke.mjs",
    "prepublishOnly": "node tools/check.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "音频播放",
    "tags": [
      "voice"
    ],
    "describe": "describe.json"
  }
}
